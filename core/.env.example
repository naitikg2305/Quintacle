ANTHROPIC_API_KEY=sk-ant-...

# Where your real data lives (journal, KB, logs, todos) — kept fully separate
# from this code checkout on purpose. Defaults to ~/.quintacle if unset.
# Point it at a synced folder, an external drive, wherever — it's just a path.
# QUINTACLE_DATA_DIR=/home/you/.quintacle

# Routine structured tasks (journal parsing, KB sorting) — cheap by default.
# QUINTACLE_LLM_MODEL=claude-haiku-4-5

# Reserved for heavier "research" tasks (e.g. the KB-grounded chat) — bump
# this independently when you want more power without making routine
# parsing more expensive too.
# QUINTACLE_LLM_RESEARCH_MODEL=claude-sonnet-5
